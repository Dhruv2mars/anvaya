{
  "expo": {
    "name": "Anvaya",
    "slug": "anvaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anvaya",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anvaya.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Anvaya uses your location to compute accurate sunrise and Hindu Panchang (Tithi, Vaar, Paksha) for your place. Location is stored only on your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anvaya.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#EEF3F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Anvaya uses your location to compute accurate sunrise and Hindu Panchang for your place. Location stays on your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF3F8",
          "imageWidth": 180
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "dhruv2mars",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcb3ab25-e9a7-4d14-b8ed-c7ecc6aaf642"
      }
    }
  }
}
